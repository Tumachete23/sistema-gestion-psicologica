COMPOSE_PROJECT_NAME=psicologia
BACKEND_PORT=8000
FRONTEND_PORT=5173
APP_NAME="Gestion psicologica"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psicologia
DB_USERNAME=psicologia
# Define una clave local antes de iniciar Compose. No la publiques.
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
MAIL_MAILER=log
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
VITE_USE_POLLING=true
