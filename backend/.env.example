COMPOSE_PROJECT_NAME=psicologia
BACKEND_PORT=8000
FRONTEND_PORT=5173
APP_NAME="Gestion psicologica"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=psicologia
DB_USERNAME=psicologia
# El inicializador local genera una clave únicamente al crear backend/.env.
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=sync
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=psicologia_local_
CACHE_PREFIX=psicologia_local_cache_
MAIL_MAILER=log
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
VITE_USE_POLLING=true
